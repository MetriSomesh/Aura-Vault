{
  "expo": {
    "name": "Aura Vault",
    "slug": "aura-vault",
    "scheme": "aura-vault",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.auravault.app",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Aura Vault requires biometric authentication to secure your bullion portfolio."
      }
    },
    "icon": "./assets/images/icon.png",
    "android": {
      "package": "com.auravault.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#08090C"
      },
      "permissions": [
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "CAMERA",
        "READ_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Aura Vault to use Face ID / Fingerprint to securely access your portfolio."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Aura Vault to access photos to attach receipt/invoice photos to bullion holdings."
        }
      ],
      "expo-sqlite",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
